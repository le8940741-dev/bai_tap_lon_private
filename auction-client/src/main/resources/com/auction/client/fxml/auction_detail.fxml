<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.AuctionDetailController"
            styleClass="root-pane"
            minWidth="960" minHeight="680">

    <!-- Nav -->
    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <Button text="← Back" onAction="#onBack" styleClass="btn-secondary"/>
            <Text text="Auction Detail" styleClass="nav-logo"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.42" styleClass="content-pane">

            <!-- Left: info + bidding -->
            <VBox spacing="12" styleClass="detail-left">
                <Text fx:id="labelTitle" styleClass="item-title" wrappingWidth="380"/>
                <HBox spacing="8">
                    <Label text="Category:" styleClass="form-label"/>
                    <Label fx:id="labelCategory" styleClass="detail-value"/>
                </HBox>
                <Label fx:id="labelDescription" styleClass="item-desc" wrapText="true" maxWidth="380"/>
                <Separator/>
                <HBox spacing="8">
                    <Label text="Seller:" styleClass="form-label"/>
                    <Label fx:id="labelSeller" styleClass="detail-value"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Status:" styleClass="form-label"/>
                    <Label fx:id="labelStatus" styleClass="detail-value"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Ends:" styleClass="form-label"/>
                    <Label fx:id="labelEndTime" styleClass="detail-value"/>
                    <Label fx:id="labelCountdown" styleClass="countdown"/>
                </HBox>
                <HBox spacing="12" styleClass="price-row" alignment="CENTER_LEFT">
                    <Label text="Current Price" styleClass="price-label"/>
                    <Label fx:id="labelCurrentPrice" styleClass="price-value"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Leader:" styleClass="form-label"/>
                    <Label fx:id="labelLeader" styleClass="detail-value"/>
                </HBox>

                <Separator/>

                <!-- Manual bid -->
                <Text text="Place a Bid" styleClass="section-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="bidAmountField" promptText="Amount ($)"
                               styleClass="input-field" prefWidth="160"/>
                    <Button fx:id="bidButton" text="BID NOW" onAction="#onPlaceBid"
                            styleClass="btn-primary"/>
                </HBox>

                <!-- Auto-bid -->
                <Text text="Auto-Bid" styleClass="section-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="autoBidMaxField"  promptText="Max ($)"
                               styleClass="input-field" prefWidth="110"/>
                    <TextField fx:id="autoBidIncrField" promptText="Increment ($)"
                               styleClass="input-field" prefWidth="120"/>
                    <Button fx:id="autoBidButton" text="SET" onAction="#onSetAutoBid"
                            styleClass="btn-secondary"/>
                </HBox>
                <Label fx:id="bidStatusLabel" styleClass="bid-status" wrapText="true" maxWidth="380"/>
            </VBox>

            <!-- Right: chart + history -->
            <VBox spacing="10" styleClass="detail-right">
                <Text text="Price History" styleClass="section-title"/>
                <LineChart fx:id="priceChart" VBox.vgrow="SOMETIMES" prefHeight="220"
                           legendVisible="false">
                    <xAxis><NumberAxis fx:id="xAxis" label="Time (s)"/></xAxis>
                    <yAxis><NumberAxis fx:id="yAxis" label="Price ($)"/></yAxis>
                </LineChart>

                <Text text="Bid Log" styleClass="section-title"/>
                <TableView fx:id="bidTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colBidder" text="Bidder" prefWidth="130"/>
                        <TableColumn fx:id="colAmount" text="Amount" prefWidth="90"/>
                        <TableColumn fx:id="colTime"   text="Time"   prefWidth="80"/>
                        <TableColumn fx:id="colAuto"   text="Type"   prefWidth="60"/>
                    </columns>
                    <placeholder><Label text="No bids yet." styleClass="table-placeholder"/></placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
