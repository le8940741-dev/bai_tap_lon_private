<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.LoginController"
      styleClass="root-pane"
      alignment="CENTER" spacing="0"
      minWidth="900" minHeight="620">

    <VBox styleClass="auth-card" alignment="CENTER" spacing="20" maxWidth="400">
        <Text text="AUCTION" styleClass="logo-text"/>
        <Text text="SYSTEM" styleClass="logo-sub"/>

        <Label text="Sign in to your account" styleClass="auth-hint"/>

        <TextField fx:id="usernameField" promptText="Username" styleClass="input-field" maxWidth="320"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-field" maxWidth="320"/>

        <Label fx:id="statusLabel" styleClass="status-error" wrapText="true" maxWidth="320"/>

        <Button fx:id="loginButton" text="LOG IN" onAction="#onLogin"
                styleClass="btn-primary" maxWidth="320"/>

        <Button text="Create an account" onAction="#onGoRegister" styleClass="btn-link"/>
    </VBox>
</VBox>
