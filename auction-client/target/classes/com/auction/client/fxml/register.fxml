<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.auction.client.controller.RegisterController"
      styleClass="root-pane"
      alignment="CENTER" spacing="0"
      minWidth="900" minHeight="620">

    <VBox styleClass="auth-card" alignment="CENTER" spacing="16" maxWidth="420">
        <Text text="Create Account" styleClass="page-title"/>

        <TextField  fx:id="usernameField" promptText="Username"         styleClass="input-field" maxWidth="340"/>
        <TextField  fx:id="emailField"    promptText="Email"            styleClass="input-field" maxWidth="340"/>
        <PasswordField fx:id="passwordField" promptText="Password"      styleClass="input-field" maxWidth="340"/>
        <PasswordField fx:id="confirmField"  promptText="Confirm Password" styleClass="input-field" maxWidth="340"/>

        <HBox alignment="CENTER_LEFT" spacing="12" maxWidth="340">
            <Label text="Account type:" styleClass="form-label"/>
            <ComboBox fx:id="roleCombo" styleClass="input-field"/>
        </HBox>

        <Label fx:id="statusLabel" styleClass="status-error" wrapText="true" maxWidth="340"/>

        <Button fx:id="registerButton" text="REGISTER" onAction="#onRegister"
                styleClass="btn-primary" maxWidth="340"/>
        <Button text="Already have an account? Log in" onAction="#onBackToLogin" styleClass="btn-link"/>
    </VBox>
</VBox>
