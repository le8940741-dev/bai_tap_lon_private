<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.AdminController"
            styleClass="root-pane"
            minWidth="900" minHeight="620">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <Text text="ADMIN PANEL" styleClass="nav-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="nav-user"/>
            <Button text="View Auctions" onAction="#onViewAuctions" styleClass="btn-secondary"/>
            <Button text="Log Out"       onAction="#onLogout"       styleClass="btn-danger"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="content-pane">
            <Text text="User Management" styleClass="page-title"/>

            <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"       prefWidth="50"/>
                    <TableColumn fx:id="colUsername"  text="Username" prefWidth="180"/>
                    <TableColumn fx:id="colEmail"     text="Email"    prefWidth="220"/>
                    <TableColumn fx:id="colRole"      text="Role"     prefWidth="100"/>
                    <TableColumn fx:id="colActive"    text="Status"   prefWidth="90"/>
                </columns>
                <placeholder><Label text="No users." styleClass="table-placeholder"/></placeholder>
            </TableView>

            <HBox spacing="10">
                <Button text="Refresh"      onAction="#onRefresh"  styleClass="btn-secondary"/>
                <Button text="Ban Selected" onAction="#onBanUser"  styleClass="btn-danger"/>
                <Label fx:id="statusLabel" styleClass="bid-status"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
