<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.AuctionListController"
            styleClass="root-pane"
            minWidth="900" minHeight="620">

    <!-- Top nav bar -->
    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <Text text="AUCTION SYSTEM" styleClass="nav-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="nav-user"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="btn-secondary"/>
            <Button text="Log Out" onAction="#onLogout" styleClass="btn-danger"/>
        </HBox>
    </top>

    <!-- Content -->
    <center>
        <VBox spacing="14" styleClass="content-pane">
            <Text text="Live Auctions" styleClass="page-title"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Search by item name or status…"
                           styleClass="input-field" prefWidth="360"/>
                <Button text="View Selected" onAction="#onViewDetail" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colId"     text="#"          prefWidth="50"/>
                    <TableColumn fx:id="colItem"   text="Item"       prefWidth="260"/>
                    <TableColumn fx:id="colPrice"  text="Price"      prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status"     prefWidth="110"/>
                    <TableColumn fx:id="colEnds"   text="Ends"       prefWidth="140"/>
                </columns>
                <placeholder><Label text="No auctions found." styleClass="table-placeholder"/></placeholder>
            </TableView>
        </VBox>
    </center>
</BorderPane>
