<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.auction.client.controller.SellerDashboardController"
            styleClass="root-pane"
            minWidth="960" minHeight="680">

    <top>
        <HBox styleClass="nav-bar" alignment="CENTER_LEFT" spacing="16">
            <Text text="SELLER DASHBOARD" styleClass="nav-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="nav-user"/>
            <Button text="Browse Auctions" onAction="#onViewAuctions" styleClass="btn-secondary"/>
            <Button text="Log Out"         onAction="#onLogout"       styleClass="btn-danger"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55" styleClass="content-pane">

            <!-- Left: my auctions -->
            <VBox spacing="12">
                <Text text="My Auctions" styleClass="page-title"/>
                <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colItem"   text="Item"   prefWidth="200"/>
                        <TableColumn fx:id="colPrice"  text="Price"  prefWidth="90"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colEnds"   text="Ends"   prefWidth="140"/>
                    </columns>
                    <placeholder><Label text="No auctions yet." styleClass="table-placeholder"/></placeholder>
                </TableView>
                <HBox spacing="10">
                    <Button text="Cancel Selected" onAction="#onCancelAuction" styleClass="btn-danger"/>
                </HBox>
            </VBox>

            <!-- Right: create forms -->
            <VBox spacing="18">
                <!-- Create item -->
                <VBox styleClass="form-card" spacing="10">
                    <Text text="New Item" styleClass="section-title"/>
                    <TextField fx:id="itemNameField" promptText="Item name" styleClass="input-field"/>
                    <TextArea  fx:id="itemDescField" promptText="Description"
                               styleClass="input-field" prefHeight="70" wrapText="true"/>
                    <TextField fx:id="itemImageField"
                               promptText="Image URL or local file path"
                               styleClass="input-field"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ComboBox fx:id="itemCategoryCombo" styleClass="input-field"/>
                        <TextField fx:id="itemExtraField" promptText="Extra info (JSON)"
                                   styleClass="input-field" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button text="Create Item" onAction="#onCreateItem" styleClass="btn-primary"/>
                </VBox>

                <!-- Create auction -->
                <VBox styleClass="form-card" spacing="10">
                    <Text text="New Auction" styleClass="section-title"/>
                    <ComboBox fx:id="itemCombo" styleClass="input-field" maxWidth="9999"/>
                    <TextField fx:id="startPriceField" promptText="Starting price ($)"
                               styleClass="input-field"/>
                    <TextField fx:id="startTimeField"
                               promptText="Start time (yyyy-MM-ddTHH:mm:ss, blank=now)"
                               styleClass="input-field"/>
                    <TextField fx:id="endTimeField"
                               promptText="End time (yyyy-MM-ddTHH:mm:ss)"
                               styleClass="input-field"/>
                    <Button text="Create Auction" onAction="#onCreateAuction" styleClass="btn-primary"/>
                </VBox>

                <Label fx:id="statusLabel" styleClass="bid-status" wrapText="true"/>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
